parameters:
    level: 5

    paths:
        - commands
        - components
        - controllers
        - dto
        - forms
        - helpers
        - mail
        - models
        - modules
        - services

    scanDirectories:
        - tests/Support

    bootstrapFiles:
        - tests/_bootstrap.php

    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    tmpDir: %currentWorkingDirectory%/runtime
